{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "src/preload/**/*",
    "src/shared/**/*",
    "src/common/**/*",
    "typings/**/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["jest", "node"],
    "typeRoots": ["./node_modules/@types", "./typings"],
    "baseUrl": ".",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@preload/*": ["src/preload/*"],
      "@common/*": ["src/common/*"]
    }
  }
}
