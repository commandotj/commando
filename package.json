{
    "name": "electron-vite-react",
    "version": "2.1.0",
    "main": "dist-electron/main/index.js",
    "description": "Commando another alternative to Total Commander",
    "author": "Albert Li <albert_lee@hotmail.com>",
    "license": "MIT",
    "private": true,
    "debug": {
        "env": {
            "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
        }
    },
    "scripts": {
        "dev": "npx concurrently \"yarn tsc:preload:watch\" \"vite\"",
        "tsc:preload:watch": "tsc --project electron/tsconfig.preload.json --watch",
        "build": "tsc && vite build && electron-builder",
        "preview": "vite preview",
        "pree2e": "vite build --mode=test",
        "e2e": "playwright test"
    },
    "devDependencies": {
        "@playwright/test": "^1.29.2",
        "@types/react": "^18.0.27",
        "@types/react-dom": "^18.0.10",
        "@vitejs/plugin-react": "^3.0.1",
        "concurrently": "^9.1.2",
        "electron": "^36.4.0",
        "electron-builder": "^26.0.12",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-splitter-layout": "^4.0.0",
        "sass": "^1.57.1",
        "typescript": "^4.9.4",
        "vite": "^4.0.4",
        "vite-electron-plugin": "^0.7.4",
        "vite-plugin-electron-renderer": "^0.12.1"
    },
    "engines": {
        "node": "^14.18.0 || >=16.0.0"
    },
    "volta": {
        "node": "22.16.0",
        "yarn": "1.22.17"
    },
    "dependencies": {
        "@chakra-ui/react": "^2.5.0",
        "@emotion/react": "^11.10.5",
        "@emotion/styled": "^11.10.5",
        "@reduxjs/toolkit": "^1.9.3",
        "antd": "^5.2.1",
        "framer-motion": "^9.0.2",
        "klaw": "^4.1.0",
        "react-redux": "^8.0.5",
        "redux": "^4.2.1"
    }
}
