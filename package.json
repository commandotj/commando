{
    "name": "commando",
    "version": "2.1.0",
    "main": "./dist-electron/main/index.js",
    "description": "Commando another alternative to Total Commander",
    "author": "Albert Li <albert_lee@hotmail.com>",
    "license": "MIT",
    "private": true,
    "debug": {
        "env": {
            "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
        }
    },
    "scripts": {
        "dev": "npm run clean && npm run build:i18n && npx concurrently \"npm run tsc:preload:watch\" \"vite\" \"npm run i18n:watch\"",
        "tsc:preload:watch": "tsc --project electron/tsconfig.preload.json --watch",
        "build": "npm run clean && tsc && vite build && build:i18n && electron-builder",
        "build:i18n": "mkdir -p dist-electron/main/ && cp -r electron/main/i18n dist-electron/main/",
        "preview": "vite preview",
        "pree2e": "vite build --mode=test",
        "e2e": "E2E_TEST=1 playwright test",
        "test": "jest",
        "postinstall": "playwright install --with-deps",
        "i18n:watch": "chokidar 'electron/main/i18n/**/*' -c 'npm run build:i18n'",
        "clean": "rm -rf dist-electron"
    },
    "devDependencies": {
        "@playwright/test": "^1.29.2",
        "@tailwindcss/postcss": "^4.1.10",
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^14.0.0",
        "@types/jest": "^29.5.14",
        "@types/react": "^18.0.27",
        "@types/react-dom": "^18.0.10",
        "@types/redux-mock-store": "^1.5.0",
        "@vitejs/plugin-react": "^3.0.1",
        "autoprefixer": "^10.4.21",
        "chokidar-cli": "^3.0.0",
        "concurrently": "^9.1.2",
        "electron": "^36.4.0",
        "electron-builder": "^26.0.12",
        "electron-devtools-installer": "^4.0.0",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "postcss": "^8.5.4",
        "rc-util": "^5.44.4",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "redux-mock-store": "^1.5.5",
        "sass": "^1.57.1",
        "tailwindcss": "^3.4.17",
        "ts-jest": "^29.3.4",
        "typescript": "^4.9.4",
        "vite": "^6.3.5",
        "vite-electron-plugin": "^0.7.4",
        "vite-plugin-electron-renderer": "^0.12.1",
        "vite-plugin-static-copy": "^3.0.2"
    },
    "engines": {
        "node": "^14.18.0 || >=16.0.0"
    },
    "volta": {
        "node": "22.16.0",
        "yarn": "1.22.17"
    },
    "dependencies": {
        "@chakra-ui/react": "^2.5.0",
        "@dnd-kit/core": "6.1.0",
        "@dnd-kit/modifiers": "7.0.0",
        "@dnd-kit/sortable": "7.0.2",
        "@dnd-kit/utilities": "3.2.1",
        "@emotion/react": "^11.10.5",
        "@emotion/styled": "^11.10.5",
        "@radix-ui/react-dropdown-menu": "^2.1.15",
        "@radix-ui/react-icons": "^1.3.2",
        "@radix-ui/react-menubar": "^1.1.15",
        "@radix-ui/themes": "^3.2.1",
        "@reduxjs/toolkit": "^1.9.3",
        "@tanstack/react-table": "^8.21.3",
        "@types/react-resizable": "^3.0.8",
        "drivelist": "^12.0.2",
        "framer-motion": "^9.0.2",
        "i18next": "^25.2.1",
        "klaw": "^4.1.0",
        "react-redux": "^8.0.5",
        "react-resizable": "^3.0.5",
        "redux": "^4.2.1"
    }
}
