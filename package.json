{
    "name": "commando-client",
    "version": "1.0.0",
    "description": "Another Two Panel File Manager",
    "main": "./out/main/index.js",
    "author": "albert_lee@hotmail.com",
    "homepage": "https://www.systembug.com/commando",
    "scripts": {
        "format": "prettier --write .",
        "lint": "eslint --cache .",
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "start": "electron-vite preview",
        "dev": "electron-vite dev",
        "build": "npm run typecheck && electron-vite build",
        "gen:worker-support": "node scripts/genWorkerModuleSupport.js",
        "postinstall": "npm run gen:worker-support",
        "build:unpack": "npm run build && electron-builder --dir",
        "build:win": "npm run build && electron-builder --win",
        "build:mac": "electron-vite build && electron-builder --mac",
        "build:linux": "electron-vite build && electron-builder --linux",
        "test": "npm run gen:worker-support && jest --runInBand",
        "test:coverage": "jest --coverage --runInBand"
    },
    "dependencies": {
        "@chakra-ui/react": "^2.5.0",
        "@dnd-kit/core": "6.1.0",
        "@dnd-kit/modifiers": "7.0.0",
        "@dnd-kit/sortable": "7.0.2",
        "@dnd-kit/utilities": "3.2.1",
        "@electron-toolkit/preload": "^3.0.1",
        "@electron-toolkit/utils": "^4.0.0",
        "@emotion/react": "^11.10.5",
        "@emotion/styled": "^11.10.5",
        "@radix-ui/react-dropdown-menu": "^2.1.15",
        "@radix-ui/react-icons": "^1.3.2",
        "@radix-ui/react-menubar": "^1.1.15",
        "@radix-ui/themes": "^3.2.1",
        "@reduxjs/toolkit": "^1.9.3",
        "@tanstack/react-table": "^8.21.3",
        "@types/react-resizable": "^3.0.8",
        "drivelist": "^12.0.2",
        "electron-updater": "^6.3.9",
        "framer-motion": "^9.0.2",
        "i18next": "^25.2.1",
        "klaw": "^4.1.0",
        "p-queue": "^8.1.0",
        "react-redux": "^8.0.5",
        "react-resizable": "^3.0.5",
        "redux": "^4.2.1",
        "simplebar": "^6.3.1",
        "simplebar-react": "^3.3.1"
    },
    "devDependencies": {
        "@electron-toolkit/eslint-config-ts": "^3.0.0",
        "@electron-toolkit/tsconfig": "^1.0.1",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.14.1",
        "@types/react": "^18.3.23",
        "@types/react-dom": "^18.3.7",
        "@types/redux-mock-store": "^1.5.0",
        "@types/testing-library__jest-dom": "^5.14.9",
        "@types/testing-library__react": "^10.0.1",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.16",
        "electron": "^35.1.5",
        "electron-builder": "^25.1.8",
        "electron-vite": "^3.1.0",
        "eslint": "^9.24.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "prettier": "^3.5.3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "redux-mock-store": "^1.5.5",
        "tailwindcss": "^3.4.17",
        "ts-jest": "^29.4.0",
        "typescript": "^5.8.3",
        "vite": "^6.2.6"
    }
}
