{
    "name": "commando",
    "private": true,
    "version": "1.0.0",
    "description": "Commando File Manager - Dual Panel File Manager with Sync Support",
    "author": "albert_lee@hotmail.com",
    "homepage": "https://www.systembug.com/commando",
    "packageManager": "pnpm@10.27.0",
    "scripts": {
        "cli": "make cli",
        "cli:install": "make cli-install",
        "setup:desktop": "bash scripts/ensure-desktop-tools.sh",
        "dev": "turbo dev --filter=@commandojs/desktop",
        "build": "turbo build",
        "test": "turbo test",
        "test:go": "make test-go",
        "desktop:build": "make desktop",
        "desktop:package": "make desktop-package",
        "desktop:install": "make desktop-install",
        "typecheck": "turbo typecheck",
        "lint": "turbo lint",
        "format": "prettier --write .",
        "generate": "pnpm --filter @commandojs/desktop generate",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.3.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.14.1",
        "@types/redux-mock-store": "^1.5.0",
        "@types/testing-library__jest-dom": "^5.14.9",
        "@types/testing-library__react": "^10.0.1",
        "eslint": "^9.24.0",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "lint-staged": "^16.2.1",
        "prettier": "^3.5.3",
        "redux-mock-store": "^1.5.5",
        "ts-jest": "^29.4.0",
        "turbo": "^2.6.3",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.65.0"
    },
    "volta": {
        "node": "22.20.0"
    },
    "pnpm": {
        "overrides": {
            "vite": "^6.2.6"
        }
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --cache --fix",
            "prettier --write"
        ],
        "*.{json,md,yaml,yml}": [
            "prettier --write"
        ]
    }
}
