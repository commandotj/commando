{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "noEmit": true
    },
    "include": ["types/**/*.ts", "constants/**/*.ts"]
}
