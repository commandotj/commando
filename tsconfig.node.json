{
    "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
    "include": [
        "electron.vite.config.*",
        "src/main/**/*",
        "src/preload/**/*",
        "src/common/**/*",
        "typings/**/*.d.ts",
        "src/main/log"
    ],
    "compilerOptions": {
        "composite": true,
        "types": ["jest"],
        "typeRoots": ["./node_modules/@types", "./typings"],
        "baseUrl": ".",
        "paths": {
            "@common/*": ["src/common/*"],
            "@main/*": ["src/main/*"],
            "@shared/*": ["src/shared/*"]
        }
    }
}
